STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Railway / production
PORT=9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000

# ── Cloudflare R2 (stockage des images éditables : Slider, Gallery, Blog, 3D) ──
# Requis pour l'upload d'images depuis le back-office. Si S3_BUCKET est absent,
# le provider fichier est désactivé (medusa-config.ts) et l'upload renvoie
# « Stockage S3 non configuré » — le storefront retombe alors sur ses images de
# secours (fallbacks). Identifiants à générer dans Cloudflare : R2 > Manage R2
# API Tokens (droits Object Read & Write sur le bucket).
S3_BUCKET=
# Endpoint S3 du compte R2 : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# URL PUBLIQUE de lecture du bucket (domaine r2.dev public ou domaine custom).
# Sert à construire les URLs renvoyées après upload. Exemple (bucket actuel) :
S3_FILE_URL=https://pub-d7ca6a51b86f4ee9838bdb8d83486ccb.r2.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
