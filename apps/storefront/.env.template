NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Domaine public du site — pilote metadataBase, les canonical, le hreflang, le
# JSON-LD et le sitemap. En production, le domaine réel : https://hinaso.fr
# (aujourd'hui https://hinaso.up.railway.app). Variable REQUISE : sans elle, le
# build échoue au lieu de publier des canonical pointant sur localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Pays servi quand l'URL ne porte pas de code pays (/blog → /fr/blog) et
# qu'aucun signal géo n'est disponible — c'est le cas sur Railway. Doit rester
# aligné sur PRIMARY_COUNTRY (src/lib/util/seo.ts), qui pilote le x-default
# hreflang : les deux désignent le marché prioritaire.
NEXT_PUBLIC_DEFAULT_REGION=fr

# Balises Google — renseigner L'UNE OU L'AUTRE, jamais les deux (GTM déploie
# déjà sa propre balise GA4 : charger gtag.js en plus dupliquerait les hits).
# Variables vides = aucune balise chargée. Dans tous les cas, rien ne part vers
# Google avant acceptation de la finalité correspondante dans le bandeau.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
